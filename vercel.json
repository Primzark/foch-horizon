{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/property-feed/import",
      "destination": "https://rcrulfdobtmfxzpuyryn.supabase.co/functions/v1/property-feed-import"
    },
    {
      "source": "/api/cities/:slug/properties",
      "destination": "https://rcrulfdobtmfxzpuyryn.supabase.co/functions/v1/city-properties/:slug"
    },
    {
      "source": "/api/cities/:slug",
      "destination": "https://rcrulfdobtmfxzpuyryn.supabase.co/functions/v1/city-detail/:slug"
    },
    {
      "source": "/api/cities",
      "destination": "https://rcrulfdobtmfxzpuyryn.supabase.co/functions/v1/cities-list"
    },
    {
      "source": "/api/properties/stats",
      "destination": "https://rcrulfdobtmfxzpuyryn.supabase.co/functions/v1/properties-stats"
    },
    {
      "source": "/api/properties/aggregate",
      "destination": "https://rcrulfdobtmfxzpuyryn.supabase.co/functions/v1/properties-aggregate"
    },
    {
      "source": "/api/properties/:id",
      "destination": "https://rcrulfdobtmfxzpuyryn.supabase.co/functions/v1/property-detail/:id"
    },
    {
      "source": "/api/properties",
      "destination": "https://rcrulfdobtmfxzpuyryn.supabase.co/functions/v1/properties-search"
    },
    {
      "source": "/api/leads",
      "destination": "https://rcrulfdobtmfxzpuyryn.supabase.co/functions/v1/leads-create"
    },
    {
      "source": "/api/google-reviews",
      "destination": "https://rcrulfdobtmfxzpuyryn.supabase.co/functions/v1/google-reviews"
    },
    {
      "source": "/api/chatbot-assistant-stream",
      "destination": "https://rcrulfdobtmfxzpuyryn.supabase.co/functions/v1/chatbot-assistant-stream"
    },
    {
      "source": "/api/chatbot-assistant",
      "destination": "https://rcrulfdobtmfxzpuyryn.supabase.co/functions/v1/chatbot-assistant"
    },
    {
      "source": "/api/chatbot-feedback",
      "destination": "https://rcrulfdobtmfxzpuyryn.supabase.co/functions/v1/chatbot-feedback"
    },
    {
      "source": "/api/chatbot-memory/reset",
      "destination": "https://rcrulfdobtmfxzpuyryn.supabase.co/functions/v1/chatbot-memory-reset"
    },
    {
      "source": "/:page(geographie|services|vendre|estimation|apropos|contact|honoraires|reglementation-immobiliere|plan-du-site|mentions-legales|confidentialite|cookies|accessibilite)",
      "destination": "/:page/index.html"
    },
    {
      "source": "/immobilier/:ville(le-havre|sainte-adresse|la-plage|gobelins|saint-michel|octeville-sur-mer|montivilliers|maneglise|gainneville|saint-romain|etretat|deauville|trouville|halles-centrales|hotel-de-ville|notre-dame|saint-francois|perrey|centre-ville|harfleur|gonfreville-l-orcher|rogerville|saint-laurent-de-brevedent|etainhus|epretot|saint-aubin-routot|la-remuee|gommerville|la-cerlangue|les-trois-pierres)",
      "destination": "/immobilier/:ville/index.html"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/spa.html"
    }
  ],
  "buildCommand": "npm run build",
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/biens-sauvegardes",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ]
}
